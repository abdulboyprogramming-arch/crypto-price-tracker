# Crypto Tracker Pro - Environment Variables
# Copy this file to .env and fill in your values

# API Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=4

# Cache Configuration
CACHE_TYPE=memory
CACHE_TTL=30

# Rate Limiting
RATE_LIMIT=100

# Logging
LOG_LEVEL=INFO

# External APIs (optional, for future API key support)
COINGECKO_API_KEY=
COINCAP_API_KEY=
BINANCE_API_KEY=

# Database (optional, for future PostgreSQL support)
DATABASE_URL=sqlite:///crypto_tracker.db

# Redis (optional, for production caching)
REDIS_URL=redis://localhost:6379

# Security (generate random values for production)
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
