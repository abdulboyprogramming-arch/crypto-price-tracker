# Multi-stage build for web application
FROM node:18-alpine AS builder

WORKDIR /app

# Copy only web app files
COPY index.html style.css script.js manifest.json sw.js offline.html ./
COPY assets/ ./assets/
COPY .gitignore ./

# Production stage
FROM nginx:alpine

# Copy only necessary web files
COPY --from=builder /app/index.html /usr/share/nginx/html/
COPY --from=builder /app/style.css /usr/share/nginx/html/
COPY --from=builder /app/script.js /usr/share/nginx/html/
COPY --from=builder /app/manifest.json /usr/share/nginx/html/
COPY --from=builder /app/sw.js /usr/share/nginx/html/
COPY --from=builder /app/offline.html /usr/share/nginx/html/
COPY --from=builder /app/assets/ /usr/share/nginx/html/assets/

# Copy custom nginx config
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|json)$ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]